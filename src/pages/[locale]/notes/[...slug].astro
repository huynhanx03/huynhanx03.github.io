---
import { render } from 'astro:content';
import PortfolioLayout from '../../../layouts/PortfolioLayout.astro';
import { getAllNotes, getEntry, getNote, getNoteDescription, getRelatedEntries, getSeries, getTranslatedNote, notePath, type NoteLocale } from '../../../content/notes';
import { absoluteSiteUrl, sitePath } from '../../../lib/paths';
import { getMessages, isLocale, localizedPath, localizedSite, termLabel } from '../../../i18n';
import { getSiteConfig } from '../../../data/portfolio';
import { buildArticleSchema, buildBreadcrumbSchema, buildPersonSchema } from '../../../lib/seo';
import { getReadingStats } from '../../../content/notes/reading-time';
import { getNoteViews } from '../../../lib/analytics/note-views';

export async function getStaticPaths() {
  const notes = await getAllNotes();
  return notes.map((note) => ({ params: { locale: note.locale, slug: note.slug }, props: { slug: note.slug, locale: note.locale } }));
}

const { slug, locale } = Astro.props as { slug: string; locale: NoteLocale };
if (!isLocale(locale)) throw new Error(`Unsupported locale: ${locale}`);
const copy = getMessages(locale);
const site = localizedSite(getSiteConfig(), locale);
const note = await getNote(slug, locale);
if (!note) throw new Error(`Missing note ${locale}/${slug}`);
const entry = await getEntry(slug, locale);
if (!entry) throw new Error(`Missing knowledge entry ${locale}/${slug}`);
const { Content, headings } = await render(note.entry);
const paired = await getTranslatedNote(note);
const related = await getRelatedEntries(entry, 4);
const series = note.data.series ? (await getSeries(note.data.series, locale)).filter((candidate) => candidate.slug !== slug) : [];
const canonical = absoluteSiteUrl(notePath(note), Astro.site ?? Astro.url);
const alternate = paired ? absoluteSiteUrl(notePath(paired), Astro.site ?? Astro.url) : undefined;
const homeUrl = absoluteSiteUrl(localizedPath(locale, '/'), Astro.site ?? Astro.url);
const notesUrl = absoluteSiteUrl(localizedPath(locale, '/notes'), Astro.site ?? Astro.url);
const description = getNoteDescription(note);
const readingStats = getReadingStats(note.entry.body ?? '', locale);
const views = getNoteViews(notePath(note));
const formattedViewsUpdatedAt = views ? new Date(`${views.updatedAt}T00:00:00`).toLocaleDateString(locale === 'vi' ? 'vi-VN' : 'en-US') : null;
const updated = note.data.updated;
const schemas = [
  buildPersonSchema(site, canonical),
  buildArticleSchema({ headline: note.data.title, description, url: canonical, locale, category: termLabel(locale, note.data.kind), image: absoluteSiteUrl('/images/og-default.png', Astro.site ?? Astro.url), wordCount: readingStats.words, updated, authorUrl: homeUrl, breadcrumbs: [{ name: copy.nav.home, url: homeUrl }, { name: copy.notes.title, url: notesUrl }, { name: note.data.title, url: canonical }] }),
  buildBreadcrumbSchema([{ name: copy.nav.home, url: homeUrl }, { name: copy.notes.title, url: notesUrl }, { name: note.data.title, url: canonical }]),
];
---
<PortfolioLayout title={`${note.data.title} | ${site.name}`} description={description} locale={locale} canonicalUrl={canonical} alternateUrl={alternate} localeSwitchUrl={paired ? notePath(paired) : sitePath(`/${locale === 'vi' ? 'en' : 'vi'}/notes`)} pagefindCategory={note.data.category} pagefindKind={note.data.kind} openGraphType="article" updated={updated} structuredData={schemas}>
  <article class="container note-article" data-pagefind-body>
    <header class="note-article-header">
      <a class="back-link" href={sitePath(`/${locale}/notes`)}>← {copy.notes.allNotes}</a>
      <div class="note-article-kicker"><p class="eyebrow note-category-label">{note.data.category}</p><div class="note-meta"><span>{readingStats.minutes} {copy.notes.minuteRead}</span>{views && <><span aria-hidden="true">·</span><span title={formattedViewsUpdatedAt ? `${copy.notes.updated} ${formattedViewsUpdatedAt}` : undefined}>{views.count.toLocaleString(locale === 'vi' ? 'vi-VN' : 'en-US')} {copy.notes.views}</span></>}{updated && <><span aria-hidden="true">·</span><time datetime={updated.toISOString()}>{copy.notes.updated} {updated.toLocaleDateString(locale === 'vi' ? 'vi-VN' : 'en-US')}</time></>}</div></div>
      <h1>{note.data.title}</h1>
    </header>
    <div class="note-layout">
      <aside class="note-toc" aria-label={copy.notes.onThisPage}>
        <p class="toc-label">{copy.notes.onThisPage}</p>
        <ol>{headings.filter((heading) => heading.depth <= 3).map((heading) => <li class:list={{ [`depth-${heading.depth}`]: true }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
      </aside>
      <div class="note-prose"><Content /></div>
    </div>
    {series.length > 0 && <section class="note-section" aria-labelledby="series-heading"><p class="eyebrow">{copy.notes.series}</p><h2 id="series-heading">{note.data.series}</h2><div class="related-grid">{series.map((candidate) => <a class="related-card" href={notePath(candidate)}><span>{candidate.data.seriesOrder ?? '↗'}</span><strong>{candidate.data.title}</strong></a>)}</div></section>}
    {related.length > 0 && <section class="note-section" aria-labelledby="related-heading"><p class="eyebrow">{copy.notes.keepExploring}</p><h2 id="related-heading">{copy.notes.related}</h2><div class="related-grid">{related.map((candidate) => <a class="related-card" href={notePath(candidate)}><span>{candidate.data.category}</span><strong>{candidate.data.title}</strong></a>)}</div></section>}
    {note.data.sources.length > 0 && <section class="note-section" aria-labelledby="sources-heading"><p class="eyebrow">{copy.notes.sources}</p><h2 id="sources-heading">{copy.notes.references}</h2><ul class="source-list">{note.data.sources.map((source) => <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.title} ↗</a></li>)}</ul></section>}
  </article>
  <script is:inline>
    const copyLabel = document.documentElement.lang === 'vi' ? 'Sao chép' : 'Copy';
    document.querySelectorAll('.note-prose pre').forEach((pre) => {
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block';
      pre.parentNode?.insertBefore(wrapper, pre);
      wrapper.append(pre);
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code';
      button.textContent = copyLabel;
      button.addEventListener('click', async () => {
        const text = pre.querySelector('code')?.textContent || pre.textContent || '';
        try {
          if (!navigator.clipboard) throw new Error('Clipboard API unavailable');
          await navigator.clipboard.writeText(text);
          button.textContent = document.documentElement.lang === 'vi' ? 'Đã chép' : 'Copied';
        } catch {
          button.textContent = document.documentElement.lang === 'vi' ? 'Không thể sao chép' : 'Copy unavailable';
        }
        window.setTimeout(() => { button.textContent = copyLabel; }, 1600);
      });
      wrapper.append(button);
    });
  </script>
</PortfolioLayout>
