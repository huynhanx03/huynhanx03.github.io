---
import { getMessages, localizedPath, localizedPathForUrl, otherLocale, type Locale } from '../../i18n';

interface Props { locale: Locale; localeSwitchUrl?: string }
const { locale, localeSwitchUrl } = Astro.props;
const copy = getMessages(locale);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: localizedPath(locale, '/'), label: copy.nav.home },
  { href: localizedPath(locale, '/experience'), label: copy.nav.experience },
  { href: localizedPath(locale, '/projects'), label: copy.nav.projects },
  { href: localizedPath(locale, '/achievements'), label: copy.nav.achievements },
  { href: localizedPath(locale, '/problem-solving'), label: copy.nav.problemSolving },
  { href: localizedPath(locale, '/notes'), label: copy.nav.notes },
];
const isCurrent = (href: string) => {
  const path = href.replace(/\/$/, '') || '/';
  if (/^\/((en|vi))$/.test(path)) return currentPath === path;
  return currentPath === path || (path !== '/' && currentPath.startsWith(`${path}/`));
};
---
<header class="site-header">
  <nav class="header-shell" aria-label={copy.nav.primary}>
    <a class="wordmark" href={localizedPath(locale, '/')} aria-label={`${copy.nav.home} — Huỳnh Mai Cao Nhân`}>
      <span class="wordmark-name">Portfolio</span>
    </a>
    <div class="primary-nav">
      {links.map((link) => <a class:list={{ active: isCurrent(link.href) }} href={link.href}>{link.label}</a>)}
    </div>
    <div class="header-actions">
      <a class="language-switch" href={localeSwitchUrl ?? localizedPathForUrl(Astro.url, otherLocale(locale))} aria-label={copy.nav.switchTo}>{locale === 'vi' ? 'EN' : 'VI'}</a>
      <button type="button" class="theme-toggle" data-theme-toggle aria-label={copy.nav.theme}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42" /></svg>
      </button>
      <button type="button" class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="mobile-navigation" aria-label={copy.nav.menu}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </nav>
  <div class="mobile-nav" id="mobile-navigation" data-mobile-nav hidden>
    {links.map((link) => <a class:list={{ active: isCurrent(link.href) }} href={link.href}>{link.label}</a>)}
  </div>
</header>
<script is:inline>
  const menuButton = document.querySelector('[data-menu-toggle]');
  const mobileNav = document.querySelector('[data-mobile-nav]');
  menuButton?.addEventListener('click', () => {
    const open = mobileNav?.hasAttribute('hidden') ?? true;
    if (open) mobileNav?.removeAttribute('hidden'); else mobileNav?.setAttribute('hidden', '');
    menuButton.setAttribute('aria-expanded', String(open));
  });
  mobileNav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => mobileNav.setAttribute('hidden', '')));
</script>
