---
import { getSiteConfig } from '../../data/portfolio';
import SocialLinks from './SocialLinks.astro';

const site = getSiteConfig();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <SocialLinks links={site.links} class="footer-socials" />
    <p>© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .footer-inner { justify-content:space-between; gap:2rem; }
  .footer-inner :global(.footer-socials) { gap:1.55rem; }
  .footer-inner :global(.footer-socials .social-link) { width:1.5rem; height:1.5rem; border:0; border-radius:0; color:var(--text); background:transparent; }
  .footer-inner :global(.footer-socials .social-link svg) { width:1.1rem; height:1.1rem; }
  .footer-inner :global(.footer-socials .social-link:hover) { color:var(--accent); background:transparent; transform:translateY(-2px); }
  .footer-inner p { margin:0; text-align:right; }
  @media (max-width:560px) { .footer-inner { min-height:96px; align-items:flex-start; flex-direction:column; justify-content:center; gap:.85rem; }.footer-inner p { text-align:left; } }
</style>
