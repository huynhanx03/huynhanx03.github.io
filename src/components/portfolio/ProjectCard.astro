---
import type { Project } from '../../data/types';
import { sitePath } from '../../lib/paths';
import { formatStarCount } from '../../lib/project-display';
import type { Messages } from '../../i18n';

interface Props { project: Project; copy: Messages }
const { project, copy } = Astro.props;
const image = project.image ? sitePath(project.image) : sitePath('/images/projects/unknown.png');
const projectUrl = project.github ?? project.demo;
const pullRequestCount = project.pullRequests?.length ?? 0;
const dialogId = `project-prs-${project.id}`;
---

<article class="project-card" data-project-card data-category={project.category}>
  {projectUrl ? <a class="project-media" href={projectUrl} target="_blank" rel="noopener noreferrer" aria-label={`${copy.pages.projects.source}: ${project.name}`}>
    <img src={image} alt={`${project.name} preview`} width="1024" height="576" loading="lazy" />
  </a> : <div class="project-media"><img src={image} alt={`${project.name} preview`} width="1024" height="576" loading="lazy" /></div>}
  <div class="project-card-body">
    <div class="project-card-head">
      <div class="project-card-title">
        <h3>{projectUrl ? <a href={projectUrl} target="_blank" rel="noopener noreferrer">{project.name}</a> : project.name}</h3>
        <p class="project-role">{project.role}</p>
      </div>
      <div class="project-actions">
        {project.stars !== undefined && <span class="project-stars" title={`${project.stars.toLocaleString()} GitHub stars`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2.5 2.93 5.94 6.56.95-4.75 4.63 1.12 6.53L12 17.47l-5.86 3.08 1.12-6.53L2.5 9.39l6.57-.95L12 2.5Z" /></svg>
          <span>{formatStarCount(project.stars)}</span>
        </span>}
        {pullRequestCount > 0 && <button class="project-action project-pr-trigger" type="button" data-project-pr-trigger aria-haspopup="dialog" aria-controls={dialogId} aria-label={`${copy.pages.projects.viewPullRequests} ${project.name} (${pullRequestCount})`} title={`${copy.pages.projects.pullRequest} ${pullRequestCount}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="6" cy="6" r="2.5" /><circle cx="18" cy="18" r="2.5" /><path d="M6 8.5v11M18 15.5v-4a5 5 0 0 0-5-5H8.5M11 3.5 8 6.5l3 3" /></svg>
          <span class="project-pr-count">{pullRequestCount}</span>
        </button>}
        {project.github && <a class="project-action project-github-link" href={project.github} target="_blank" rel="noopener noreferrer" aria-label={`${copy.pages.projects.source}: ${project.name}`} title={copy.pages.projects.source}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z" /></svg>
        </a>}
      </div>
    </div>
    <p class="project-description">{project.description}</p>
    <div class="project-tags">{project.techStack.map((tech) => <span>{tech}</span>)}</div>
    {project.demo && project.github && <div class="project-links"><a href={project.demo} target="_blank" rel="noopener noreferrer">{copy.pages.projects.live} ↗</a></div>}
  </div>
  {pullRequestCount > 0 && <dialog class="project-pr-dialog" id={dialogId} data-project-pr-dialog aria-labelledby={`${dialogId}-title`} aria-describedby={`${dialogId}-description`}>
    <div class="project-pr-dialog-inner">
      <header class="project-pr-dialog-header">
        <div>
          <h2 id={`${dialogId}-title`}>{copy.pages.projects.contributionsTo} {project.name}</h2>
          <p id={`${dialogId}-description`}>{copy.pages.projects.contributionsDescription}</p>
        </div>
        <form method="dialog"><button class="project-dialog-close" type="submit" aria-label={copy.pages.projects.close} title={copy.pages.projects.close}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m18 6-12 12M6 6l12 12" /></svg></button></form>
      </header>
      <div class="project-pr-list">
        {project.pullRequests?.map((pullRequest) => <a class="project-pr-item" href={pullRequest.url} target="_blank" rel="noopener noreferrer">
          <span class="project-pr-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="6" cy="6" r="2.5" /><circle cx="18" cy="18" r="2.5" /><path d="M6 8.5v11M18 15.5v-4a5 5 0 0 0-5-5H8.5M11 3.5 8 6.5l3 3" /></svg></span>
          <span class="project-pr-content"><strong>{pullRequest.title}</strong><span class="project-pr-number">{copy.pages.projects.pullRequest} #{pullRequest.number.replace(/^#/, '')}</span></span>
          <svg class="project-pr-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </a>)}
      </div>
    </div>
  </dialog>}
</article>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const trigger = target.closest<HTMLButtonElement>('[data-project-pr-trigger]');
    if (trigger) {
      const dialogId = trigger.getAttribute('aria-controls');
      const dialog = dialogId ? document.getElementById(dialogId) : null;
      if (dialog instanceof HTMLDialogElement) dialog.showModal();
      return;
    }

    if (target instanceof HTMLDialogElement && target.hasAttribute('data-project-pr-dialog')) {
      const bounds = target.getBoundingClientRect();
      if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) target.close();
    }
  });
</script>
