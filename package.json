{
  "name": "huynhnhan-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26.10.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-search-index.mjs",
    "preview": "astro preview",
    "check": "pnpm run content:validate && pnpm run test && pnpm run typecheck && pnpm run lint && pnpm run build",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings=0",
    "content:validate": "node scripts/validate-content.mjs",
    "search:index": "node scripts/build-search-index.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "fetch:stats": "node scripts/fetch-stats.mjs",
    "fetch:project-stars": "node scripts/fetch-project-stars.mjs",
    "fetch:note-views": "node scripts/fetch-note-views.mjs",
    "fetch:dsa": "node scripts/fetch-dsa.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.5",
    "pagefind": "1.5.2",
    "parse5": "7.3.0",
    "simple-icons": "16.33.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "26.6.3",
    "eslint": "10.11.0",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
